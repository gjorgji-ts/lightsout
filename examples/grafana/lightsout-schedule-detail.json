{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "One LightsOut schedule in full. Shows its state, what it manages, how much of that is off, how long its scaling takes, and what fails.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "arrow-left",
      "tags": [],
      "title": "Back to Overview",
      "type": "link",
      "url": "d/lightsout-overview/lightsout-overview"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Schedule: $schedule",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The state of this schedule now.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "Warming Up",
                  "color": "yellow",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "title": "Current State",
      "type": "stat",
      "targets": [
        {
          "expr": "max(lightsout_schedule_state{schedule=\"$schedule\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The time left until this schedule scales its workloads up.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "title": "Next Upscale",
      "type": "stat",
      "targets": [
        {
          "expr": "min(lightsout_next_transition_seconds{schedule=\"$schedule\", transition_type=\"upscale\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The time left until this schedule scales its workloads down.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "title": "Next Downscale",
      "type": "stat",
      "targets": [
        {
          "expr": "min(lightsout_next_transition_seconds{schedule=\"$schedule\", transition_type=\"downscale\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Counts this schedule's managed workloads that are at zero replicas or suspended right now, against the total it manages.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 25,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "title": "Workloads Down Now",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(max by (workload_type) (lightsout_scaled_workloads{schedule=\"$schedule\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Counts the scaling operations that failed inside the dashboard time range.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 5,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "title": "Errors",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(max_over_time(lightsout_scaling_errors_total{schedule=\"$schedule\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The age of the last reconcile. A schedule that stops reconciling stops scaling.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 4,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "title": "Reconcile Age",
      "type": "stat",
      "targets": [
        {
          "expr": "time() - max(lightsout_last_reconcile_timestamp_seconds{schedule=\"$schedule\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "title": "Scaling Timeline",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Each band shows how long the schedule held one state. A yellow band is a schedule that is on the way up but does not serve yet.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 70,
            "spanNulls": false,
            "insertNulls": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "Warming Up",
                  "color": "yellow",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 6,
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.9,
        "perPage": 25,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "title": "Schedule State Over Time",
      "type": "state-timeline",
      "targets": [
        {
          "expr": "max(lightsout_schedule_state{schedule=\"$schedule\"})",
          "legendFormat": "State",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Counts the workloads this schedule has scaled in each namespace. The ten busiest namespaces over the window are shown, so a schedule with hundreds of namespaces still renders. Each operator pod keeps its own counter, so the line steps down when the pod restarts.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Top 10 Namespaces by Scaling Operations (cumulative)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (namespace) (max_over_time(lightsout_scaling_operations_total{schedule=\"$schedule\"}[$__rate_interval])) and topk(10, sum by (namespace) (max_over_time(lightsout_scaling_operations_total{schedule=\"$schedule\"}[$__range])))",
          "legendFormat": "{{ namespace }}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 102,
      "title": "Workload Details",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The two lines that answer whether this schedule is doing its job. The gap between them is what is still running inside a down window.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "managed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "down"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Workloads Managed and Down",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(max by (workload_type) (lightsout_managed_workloads{schedule=\"$schedule\"}))",
          "legendFormat": "managed",
          "refId": "A"
        },
        {
          "expr": "sum(max by (workload_type) (lightsout_scaled_workloads{schedule=\"$schedule\"}))",
          "legendFormat": "down",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "How this schedule's workloads split across deployments, statefulsets and cronjobs, and how many of each are off right now.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Down"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "0"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "id": 26,
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "enablePagination": true
      },
      "title": "Workloads by Type",
      "type": "table",
      "targets": [
        {
          "expr": "max by (workload_type) (lightsout_managed_workloads{schedule=\"$schedule\"})",
          "legendFormat": "",
          "refId": "managed",
          "format": "table",
          "instant": true
        },
        {
          "expr": "max by (workload_type) (lightsout_scaled_workloads{schedule=\"$schedule\"})",
          "legendFormat": "",
          "refId": "down",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "workload_type"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "pod": true,
              "pod 1": true,
              "pod 2": true,
              "container": true,
              "container 1": true,
              "container 2": true,
              "endpoint": true,
              "endpoint 1": true,
              "endpoint 2": true,
              "service": true,
              "service 1": true,
              "service 2": true,
              "node": true,
              "node 1": true,
              "node 2": true,
              "uid": true,
              "uid 1": true,
              "uid 2": true,
              "prometheus": true,
              "prometheus 1": true,
              "prometheus 2": true,
              "prometheus_replica": true,
              "prometheus_replica 1": true,
              "prometheus_replica 2": true,
              "cluster": true,
              "cluster 1": true,
              "cluster 2": true,
              "schedule": true,
              "schedule 1": true,
              "schedule 2": true,
              "namespace": true,
              "namespace 1": true,
              "namespace 2": true,
              "kind": true,
              "kind 1": true,
              "kind 2": true,
              "transition_type": true,
              "transition_type 1": true,
              "transition_type 2": true
            },
            "renameByName": {
              "workload_type": "Type",
              "Value #managed": "Managed",
              "Value #down": "Down"
            }
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Counts the workloads the scaling passes have handled, by result. A failure line that climbs is the first sign that a pass is only half done. Each operator pod keeps its own counter, so the line steps down when the pod restarts.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Workloads Processed by Result (cumulative)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (result) (max_over_time(lightsout_scaling_workloads_processed_total{schedule=\"$schedule\"}[$__rate_interval]))",
          "legendFormat": "{{ result }}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 103,
      "title": "Performance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "How long a full scaling pass takes, by direction, over the dashboard time range. The buckets are cumulative, so this covers every pass the current operator pod has run.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "id": 12,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "title": "Scaling Duration",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, direction) (max_over_time(lightsout_scaling_duration_seconds_bucket{schedule=\"$schedule\"}[$__range])))",
          "legendFormat": "p50 {{ direction }}",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, direction) (max_over_time(lightsout_scaling_duration_seconds_bucket{schedule=\"$schedule\"}[$__range])))",
          "legendFormat": "p95 {{ direction }}",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, direction) (max_over_time(lightsout_scaling_duration_seconds_bucket{schedule=\"$schedule\"}[$__range])))",
          "legendFormat": "p99 {{ direction }}",
          "refId": "C",
          "instant": true
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Counts the batches the scaling passes have run. A schedule without rate limits runs one batch per pass, so this only says something once upscaleRateLimit or downscaleRateLimit is set. Each operator pod keeps its own counter, so the line steps down when the pod restarts.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 10,
      "options": {
        "legend": {
